# Production settings for the VPS: $DEPLOY_PATH/parking-backend/.env
# This file lives only on the server; the deploy workflow never overwrites it.
# Use plain letters/digits for passwords (they go into a database URL):
#   openssl rand -hex 24

# --- PostgreSQL (container parking_db) ---
POSTGRES_DB=parking_db
POSTGRES_USER=parking
POSTGRES_PASSWORD=

# --- Backend ---
# Long random string; changing it logs every user out.
JWT_SECRET=
TZ=Asia/Tashkent
DEFAULT_BRANCH=Markaziy Filial
# Public address of the admin panel
FRONTEND_URL=https://adminpark.duckdns.org

# Optional shared token for camera / capture-service / device-agent events
ANPR_WEBHOOK_TOKEN=

# --- Exit flow ---
EXIT_GRACE_MINUTES=15
PAYMENT_QR_TTL_MINUTES=15
PAYMENT_POLL_SECONDS=3

# --- Munis (UzQR): live | mock | off ---
MUNIS_MODE=mock
MUNIS_QR_API_URL=
MUNIS_QR_AUTH_TOKEN=
MUNIS_ORIGINAL_QR=
MUNIS_API_URL=
MUNIS_API_USERNAME=
MUNIS_API_PASSWORD=

# --- Click: off unless explicitly enabled ---
CLICK_MODE=off
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
PUBLIC_PAY_URL=
