# /etc/parking-agent/agent.env — device-agent settings.
# The file holds the agent token: keep it readable by root/parking-agent only.

# Backend base URL (the cloud server). Use https:// in production.
AGENT_SERVER_URL=https://apipark.duckdns.org

# Token shown once when the agent is created in the admin panel
# (POST /api/v1/agents). Rotate it there if it leaks.
AGENT_TOKEN=pa_xxxxxxxxxxxxxxxx

# Local address for camera / capture-service events. Point the cameras'
# HTTP Listening to http://<agent-ip>:8090/api/v1/anpr/hikvision/<camera code>
# and the capture-service backend URL to http://<agent-ip>:8090.
# "off" disables the forwarder.
AGENT_LISTEN=:8090

# Backend's ANPR_WEBHOOK_TOKEN, if it is set there.
AGENT_ANPR_TOKEN=

# Undelivered events wait here while the internet is down.
AGENT_QUEUE_DIR=/var/lib/parking-agent/queue
# Older events are dropped: a late exit would show a payment for a car that
# already left.
AGENT_QUEUE_MAX_AGE=30m
AGENT_QUEUE_MAX_ITEMS=5000
