# Smart Parking device-agent settings (Windows).
# Installed as C:\Program Files\ParkingAgent\agent.env (readable by
# Administrators and SYSTEM only: it holds the agent token).

# Backend public URL
AGENT_SERVER_URL=https://apipark.duckdns.org

# Token shown once when the agent is created in the admin panel
# (Kamera & Shlagbaum -> Device-agentlar -> Agent qo'shish)
AGENT_TOKEN=pa_xxxxxxxxxxxxxxxx

# Cameras / capture-service on the LAN send events here:
#   http://<this PC's IP>:8090/api/v1/anpr/hikvision/<camera code>
AGENT_LISTEN=:8090

# Backend's ANPR_WEBHOOK_TOKEN (server: grep ANPR_WEBHOOK_TOKEN .env)
AGENT_ANPR_TOKEN=

# Queue for events while the internet is down, and the log file
AGENT_QUEUE_DIR=C:\ProgramData\parking-agent\queue
AGENT_QUEUE_MAX_AGE=30m
AGENT_LOG_FILE=C:\ProgramData\parking-agent\agent.log
