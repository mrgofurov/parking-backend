PORT=8085
DB_DRIVER=postgres
DB_SOURCE=postgres://sawab:sawab@localhost:5433/parking_db?sslmode=disable
# Or SQLite:
# DB_DRIVER=sqlite
# DB_SOURCE=parking.db
JWT_SECRET=super-secret-smart-parking-jwt-key-2026
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:5173
DEFAULT_BRANCH=Markaziy Filial

# --- ANPR webhooks (Hikvision camera / capture service) ---
# Ixtiyoriy umumiy token. Berilsa kamera URL'iga ?token=... qo'shiladi.
ANPR_WEBHOOK_TOKEN=

# --- Chiqish oqimi ---
EXIT_GRACE_MINUTES=15        # oldindan to'lagan mashina shu vaqt ichida bepul chiqadi
PAYMENT_QR_TTL_MINUTES=15    # QR amal qilish muddati (summa shu vaqt qotiriladi)
PAYMENT_POLL_SECONDS=3       # Munis'dan to'lovni tekshirish oralig'i

# --- Munis (UzQR) ---
# MUNIS_MODE: live | mock | off. Bo'sh = kalitlar bo'lsa live, bo'lmasa off.
MUNIS_MODE=
MUNIS_QR_API_URL=http://87.237.238.239:9092
MUNIS_QR_AUTH_TOKEN=
MUNIS_ORIGINAL_QR=
# To'lovni tekshirish API (bank tarmog'i, IPsec tunnel orqali)
MUNIS_API_URL=http://87.237.238.239:9092
MUNIS_API_USERNAME=
MUNIS_API_PASSWORD=

# --- Click (telefon orqali to'lov, doimiy QR stiker sahifasi) ---
# CLICK_MODE: live | mock | off. Bo'sh = kalitlar bo'lsa live, bo'lmasa off.
# mock — Click'ga ulanmaydi, POST /api/v1/click/mock-pay/:bill to'lovni simulyatsiya qiladi. Productionda ishlatmang!
CLICK_MODE=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Doimiy QR stiker ochadigan sahifa. Click to'lovdan keyin <PUBLIC_PAY_URL>/<kamera kodi> ga qaytaradi.
PUBLIC_PAY_URL=
